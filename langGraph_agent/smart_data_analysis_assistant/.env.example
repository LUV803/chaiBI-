# ChatBI 环境变量模板
#
# 用法：复制成 .env 并填入真实值。
#
# **全项目只有这一份 .env**，位置固定：
#     langGraph_agent/smart_data_analysis_assistant/.env
# 所有脚本都用 __file__ 显式算出这个绝对路径再去加载，不依赖当前工作目录，
# 也不依赖 find_dotenv() 的向上查找 —— 所以在哪个目录启动都读到同一份。
#
# 历史：这里曾经有两份（另一份在 chatbi_graph/ 下），分派规则是"从调用脚本所在
# 目录向上找、第一个命中的赢"，结果是 mcp_server/ 读外层、chatbi_graph/ 读内层，
# 改一份只有一半进程看得到，而且 load_dotenv 找不到文件只返回 False 不抛异常 ——
# 出错时完全静默。现已合并为一份。

# ---------- 数据库（PostgreSQL） ----------
user=postgres
password=在此填写数据库密码
db_host=127.0.0.1
db_port=5432
dbname=sales_chat

# ---------- 大模型 ----------
# DeepSeek，用于业务分流/情感分析/绘图代码生成/语义分类等
DEEPSEEK_API_KEY=sk-在此填写

# ---------- MCP 服务地址 ----------
# 4 个 MCP 服务所在主机（代码里拼接成 http://{server_url}:9002~9005）
server_url=127.0.0.1

# ---------- 其它 ----------
# 图片输出目录。注意：代码里目前并未真正读取它，
# 实际落盘位置是 python_chart_mcp 里按 __file__ 推算的 chatbi_graph/output/
IMAGE_DIR=output

# ===== 以下为新增（可选），不填则使用默认值 =====

# chat_api 的接口鉴权：填了则请求必须带 X-API-Key 头；留空则不校验
# CHATBI_API_KEY=
# chat_api 允许的跨域来源，逗号分隔；默认 * 表示放开全部但禁用凭证
# CHATBI_CORS_ORIGINS=*

# 用户 python 脚本的沙箱执行超时（秒），默认 20
# PY_SANDBOX_TIMEOUT=20

# 置 1 时构建图会额外调 mermaid.ink 在线渲染流程图到 build_graph.png，默认关闭
# DRAW_GRAPH_PNG=0

# 置 1 时打印 ReAct 子图的详细调试信息
# AGENT_DEBUG=0

# 注：post_test.py 读的就是上面的 server_url（拼成 http://{server_url}:9008/chatbi_service）。
#     它原来读的键名是 server_api_url —— 那个键从来不存在，os.getenv 返回 None 也不报错，
#     于是会拼出 "http://None:9008/..."。已改成读 server_url。
#     如果 chat_api 和 MCP 服务不在同一台机器上，再单独加一个 server_api_url 并在代码里改。
